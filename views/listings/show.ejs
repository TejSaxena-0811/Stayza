<% layout('/layouts/boilerplate') -%>

<div class="container mt-3">

    <div class="col-12 col-md-10 col-lg-8 mx-auto">
        <h3><%= listing.title %></h3>
    </div>

    <div class="card listing-card col-12 col-md-10 col-lg-8 mx-auto show-card mt-3">

        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing image">

        <div class="card-body">
            <p class="card-text">Owned by: <i><%= listing.owner.username %></i></p>

            <p class="card-text"><%= listing.description %></p>

            <p class="card-text">₹<%= listing.price.toLocaleString("en-IN") %></p>

            <p class="card-text"><%= listing.location %></p>

            <p class="card-text pb-4"><%= listing.country %></p>

            <% if(currUser && listing.owner._id.equals(currUser._id)){ %>
                <div class="btns">
                    <a href="/listings/<%= listing.id %>/edit">
                        <button class="btn edit-btn">Edit</button>
                    </a>

                    <form method="post" action="/listings/<%= listing.id %>?_method=DELETE">
                        <button class="btn btn-dark">Delete</button>
                    </form>
                </div>
            <% } %>
        </div>

        <div class="px-3 pb-3">

            <% if(currUser){ %>
                <hr>
                <h4>Leave a Review</h4>

                <form method="post" action="/listings/<%= listing.id %>/reviews" novalidate class="needs-validation">

                    <div class="mb-3 mt-3">
                        <label for="rating" class="form-label">Rating</label>

                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5">5 stars</label>
                        </fieldset>
                    </div>

                    <div>
                        <label for="comment" class="form-label">Comment</label>
                        <textarea name="review[comment]" id="comment" rows="4" class="form-control" required></textarea>
                        <div class="invalid-feedback">Please add some comments</div>
                    </div>

                    <button class="btn btn-outline-dark mt-3">Submit</button>
                </form>
            <% } %>

            <% if(listing.reviews.length > 0){ %>
                <hr>
                <h4 class="mb-3">All reviews</h4>

                <div class="row">
                    <% for(let review of listing.reviews){ %>
                        <div class="col-12 col-md-6 mb-3">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5>@<%= review.author.username %></h5>
                                    <p class="starability-result mb-2" data-rating="<%= review.rating %>"></p>
                                    <p><%= review.comment %></p>
                                </div>

                                <% if(currUser && review.author._id.equals(currUser._id)){ %>
                                    <form method="post" action="/listings/<%= listing.id %>/reviews/<%= review._id %>?_method=DELETE" class="p-2">
                                        <button class="btn btn-sm btn-dark w-100">Delete</button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>

        </div>
    </div>

    <div class="col-12 col-md-10 col-lg-8 mx-auto mt-4">
        <h3>Where you'll be</h3>
        <div id="map"></div>
    </div>
    <br>

</div>


<script>
    const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
    let mapToken = "<%= process.env.MAP_TOKEN %>";

    mapboxgl.accessToken = mapToken;

    const map = new mapboxgl.Map({
        container: 'map',
        center: coordinates,
        zoom: 8
    });

    new mapboxgl.Marker({color: 'red'})
        .setLngLat(coordinates)
        .setPopup(new mapboxgl.Popup({offset: 25})
        .setHTML("<h5>Location</h5>"))
        .addTo(map);
</script>